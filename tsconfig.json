{
    "compilerOptions": {
        "outDir": "./dist/",
        "sourceMap": true,
        "noImplicitAny": true,
        "strict": true,
        "module": "commonjs",
        "moduleResolution": "node",
        "target": "es2018",
        "jsx": "react",
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "lib": ["dom", "es2018"]
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
    ]
}